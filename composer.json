{
    "name": "jasonmccreary/test-double",
    "description": "A modern, human-friendly PHP test double library.",
    "type": "library",
    "keywords": [
        "testing",
        "test double",
        "mock",
        "stub",
        "spy"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Jason McCreary",
            "email": "jason@pureconcepts.net"
        }
    ],
    "require": {
        "php": "^8.4"
    },
    "require-dev": {
        "laravel/pint": "^1.29",
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "JMac\\Testing\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "JMac\\Testing\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
