{
    "name": "jasonmccreary/test-double",
    "type": "vendor",
    "keywords": [
        "testing",
        "mockery",
        "mock"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Jason McCreary",
            "email": "jason@pureconcepts.net"
        }
    ],
    "require": {
        "php": "^8.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "files": [
            "src/helpers.php"
        ],
        "psr-4": {
          "JMac\\Testing\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "TestDouble\\Tests\\": "tests/"
        }
    }
}
